    "author:core.novelty_assessment": {
      "type": "object",
      "properties": {
        "value": {
          "type": "object",
          "properties": {
            "prior_claim_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/reference"
              },
              "minItems": 0
            },
            "shared_content": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "new_content": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "search_scope_ref": {
              "$ref": "#/$defs/artifact_ref"
            },
            "as_of": {
              "type": "string",
              "format": "date-time"
            },
            "status": {
              "enum": [
                "claimed",
                "bounded_search",
                "expert_review"
              ]
            },
            "review_ref": {
              "$ref": "#/$defs/artifact_ref"
            }
          },
          "required": [
            "status",
            "new_content"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "bounded_search"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "required": [
                  "search_scope_ref",
                  "as_of"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "expert_review"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "required": [
                  "review_ref"
                ]
              }
            }
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "value",
        "locator"
      ],
      "additionalProperties": false
    },
