          },
          "required": [
            "outcome"
          ],
          "additionalProperties": false
        },
        "src": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "assessment": {
          "$ref": "#/$defs/assessment"
        }
      },
      "required": [
        "value",
        "src"
      ],
      "additionalProperties": false
    },
    "author:evidence.references[].access_context": {
      "type": "object",
      "properties": {
        "value": {
          "type": "object",
          "properties": {
            "source_ref": {
              "oneOf": [
                {
                  "$ref": "#/$defs/artifact_ref"
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "unavailable"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "kind",
                    "label",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "text_scope": {
              "enum": [
                "abstract",
                "full_text",
                "supplement",
                "metadata",
                "unknown"
              ]
            },
            "truncated": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "inspected_locator_range": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "enum": [
                          "byte",
                          "unicode_codepoint"
                        ]
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "unit",
                      "start",
                      "end"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "retrieval_status": {
              "enum": [
                "retrieved",
                "failed",
                "excluded",
                "unknown"
              ]
            },
            "alternate_source_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/reference"
              },
              "minItems": 0
            },
            "limitation": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "retrieval_record_ref": {
              "$ref": "#/$defs/artifact_ref"
            }
          },
          "required": [
            "source_ref",
            "text_scope",
            "truncated",
            "inspected_locator_range",
            "retrieval_status",
            "retrieval_record_ref"
          ],
          "additionalProperties": false
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "value",
        "locator"
      ],
      "additionalProperties": false
    },
