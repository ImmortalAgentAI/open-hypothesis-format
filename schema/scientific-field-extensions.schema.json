{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ohf:scientific-field-extensions@1",
  "title": "Five scientific field extensions and the records they reference",
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "artifact"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "json_pointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        }
      },
      "required": [
        "kind",
        "sha256"
      ],
      "additionalProperties": false
    },
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "card"
            },
            "pointer": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
            }
          },
          "required": [
            "kind",
            "pointer"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "artifact"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "json_pointer": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
            }
          },
          "required": [
            "kind",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "external"
            },
            "uri": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "limitation": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "kind",
            "uri",
            "limitation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unavailable"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "kind",
            "label",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "assessment": {
      "type": "object",
      "properties": {
        "assessor": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "assessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_ref": {
          "$ref": "#/$defs/artifact_ref"
        }
      },
      "required": [
        "assessor",
        "assessed_at",
        "evidence_ref"
      ],
      "additionalProperties": false
    },
    "author:core.potential_benefit": {
      "type": "object",
      "properties": {
        "value": {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "beneficiaries_or_system": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "causal_bridge": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "magnitude": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "horizon": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "constraints": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "minItems": 0
            },
            "target_refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/reference"
              },
              "minItems": 0
            }
          },
          "required": [
            "outcome"
          ],
          "additionalProperties": false
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "value",
        "locator"
      ],
      "additionalProperties": false
    },
    "added:core.potential_benefit": {
      "type": "object",
      "properties": {
        "value": {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
