{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ohf:hypothesis-relations@1",
  "title": "Hypothesis relations, version 1",
  "description": "Detached typed relations between card versions within a fixed pool. Relation types: rival_same_explanandum, nested, compatible_independent, duplicate, refines, unrelated, analog, mechanism_neighbour. From OHF 1.1 an end may name one record of its card version, such as an atom, by pointer. From OHF 1.1 an edge may list in scope_differs the endpoint, population or system on which the two cards differ, each with the field of both cards.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ohf:hypothesis-relations@1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "pool": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^h_[a-z0-9-]+(?![\\s\\S])"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "content_hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
                "minLength": 71,
                "maxLength": 71
              },
              "pointer": {
                "type": "string",
                "pattern": "^/(?:author|added)/layers(?:/(?:[^~/]|~[01])*)+$"
              }
            },
            "required": [
              "id",
              "version",
              "content_hash"
            ],
            "additionalProperties": false
          },
          "target": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^h_[a-z0-9-]+(?![\\s\\S])"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "content_hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
                "minLength": 71,
                "maxLength": 71
              },
              "pointer": {
                "type": "string",
                "pattern": "^/(?:author|added)/layers(?:/(?:[^~/]|~[01])*)+$"
              }
            },
            "required": [
              "id",
              "version",
              "content_hash"
            ],
            "additionalProperties": false
          },
          "type": {
            "enum": [
              "rival_same_explanandum",
              "nested",
              "compatible_independent",
              "duplicate",
              "refines",
              "unrelated",
              "analog",
              "mechanism_neighbour"
            ]
          },
          "basis": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "quote",
                    "reference"
                  ]
                },
                "applies_to": {
                  "enum": [
                    "source",
                    "target",
                    "both"
                  ]
                },
                "ref": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "namespace": {
                          "const": "card"
                        },
                        "card": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^h_[a-z0-9-]+(?![\\s\\S])"
                            },
                            "version": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "content_hash": {
                              "type": "string",
                              "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
                              "minLength": 71,
                              "maxLength": 71
                            }
                          },
                          "required": [
                            "id",
                            "version",
                            "content_hash"
                          ],
                          "additionalProperties": false
                        },
                        "pool": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "\\S"
                            },
                            "sha256": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
                              "minLength": 64,
                              "maxLength": 64
                            }
                          },
                          "required": [
                            "id",
                            "sha256"
                          ],
                          "additionalProperties": false
                        },
                        "pointer": {
                          "type": "string",
                          "pattern": "^/"
                        }
                      },
                      "required": [
                        "namespace",
                        "card",
                        "pool",
                        "pointer"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "namespace": {
                          "const": "artifact"
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
                          "minLength": 64,
                          "maxLength": 64
                        },
                        "locator": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "namespace",
                        "sha256",
                        "locator"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "kind",
                "applies_to",
                "ref"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "quote"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "quote"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "quote"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "by": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "scope_differs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "aspect": {
                  "enum": [
                    "endpoint",
                    "population",
                    "system"
                  ]
                },
                "source_pointer": {
                  "type": "string",
                  "pattern": "^/(?:author|added)/layers(?:/(?:[^~/]|~[01])*)+$"
                },
                "target_pointer": {
                  "type": "string",
                  "pattern": "^/(?:author|added)/layers(?:/(?:[^~/]|~[01])*)+$"
                }
              },
              "required": [
                "aspect",
                "source_pointer",
                "target_pointer"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "source",
          "target",
          "type",
          "basis",
          "rationale",
          "by",
          "at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "id",
    "revision",
    "pool",
    "edges"
  ],
  "additionalProperties": false
}
